+                  <div className="text-xs text-muted-foreground capitalize truncate">
+                    {d.design.status ?? "—"}
+                  </div>
+                </Link>
+              ) : null,
+            )}
+          </div>
+        )}
+      </section>
+    </div>
+  );
+}
diff --git a/src/pages/admin/CollectionsList.tsx b/src/pages/admin/CollectionsList.tsx
