+      if (!q) return true;
+      return (
+        (a.title ?? "").toLowerCase().includes(q) ||
+        (a.file_name ?? "").toLowerCase().includes(q) ||
+        (a.asset_type ?? "").toLowerCase().includes(q)
+      );
+    });
+  }, [assets, activeFolder, search]);
+
+  const isEmpty = !loading && assets && assets.length === 0;
+
+  return (
