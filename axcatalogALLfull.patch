+        supabase
+          .from("collections")
+          .select("id, name, collection_type, status")
+          .eq("team_id", id)
+          .order("name", { ascending: true }),
+      ]);
+      if (!active) return;
+      setRoster((ath.data ?? []) as AthleteLite[]);
+      setCollections((col.data ?? []) as CollectionLite[]);
+      setLoading(false);
+    })();
+    return () => {
+      active = false;
+    };
+  }, [id]);
+
+  if (loading) {
