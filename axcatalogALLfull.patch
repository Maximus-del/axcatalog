+
+interface Folder {
+  id: string;
+  name: string;
+  sort_order: number;
+}
+interface Asset {
+  id: string;
+  folder_id: string | null;
+  storage_bucket: string;
+  storage_path: string;
+  thumbnail_path: string | null;
+  file_name: string | null;
