# react-day-picker@8 declares a peer of date-fns ^2 || ^3, but this project runs
# date-fns 4 (which is what bun.lockb installs, and therefore what production has
# always shipped). Strict npm peer resolution rejects that combination outright,
# so npm install / npm ci fail while bun succeeds. This makes npm resolve the
# same tree bun does instead of erroring.
# Remove this once react-day-picker is upgraded to v9 (its peers accept date-fns 4).
legacy-peer-deps=true
